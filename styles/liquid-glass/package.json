{
  "name": "@platform-kit/liquid-glass",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Apache-2.0 liquid glass appearance pack: a rim-refracting lens and glass surface and field materials.",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md",
    "NOTICE",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/browser.js",
    "./dist/liquid-glass.browser.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./browser": "./dist/liquid-glass.browser.js",
    "./style.css": "./dist/liquid-glass.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node build.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
