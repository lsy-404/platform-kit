{
  "name": "@model-auth/providers",
  "version": "0.4.0",
  "description": "Host-side browser OAuth for OpenAI, Anthropic, WorkBuddy and Trae.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "workbuddy": [
        "dist/workbuddy.d.ts"
      ],
      "trae": [
        "dist/trae.d.ts"
      ],
      "openai": [
        "dist/openai.d.ts"
      ],
      "anthropic": [
        "dist/anthropic.d.ts"
      ]
    }
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD-PARTY.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./workbuddy": {
      "types": "./dist/workbuddy.d.ts",
      "import": "./dist/workbuddy.js"
    },
    "./trae": {
      "types": "./dist/trae.d.ts",
      "import": "./dist/trae.js"
    },
    "./openai": {
      "types": "./dist/openai.d.ts",
      "import": "./dist/openai.js"
    },
    "./anthropic": {
      "types": "./dist/anthropic.d.ts",
      "import": "./dist/anthropic.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "tough-cookie": "6.0.2"
  }
}
