{
  "name": "@model-auth/providers",
  "version": "0.20.0",
  "description": "Host-side AI provider access, authentication, requests and usage queries.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "workbuddy": [
        "dist/workbuddy.d.ts"
      ],
      "trae": [
        "dist/trae.d.ts"
      ],
      "openai": [
        "dist/openai.d.ts"
      ],
      "anthropic": [
        "dist/anthropic.d.ts"
      ],
      "grok": [
        "dist/grok.d.ts"
      ],
      "ollama": [
        "dist/ollama.d.ts"
      ],
      "opencode": [
        "dist/opencode.d.ts"
      ],
      "usage": [
        "dist/usage.d.ts"
      ],
      "reset-credits": [
        "dist/reset-credits.d.ts"
      ],
      "pi": [
        "dist/pi.d.ts"
      ],
      "client-versions": [
        "dist/client-versions.d.ts"
      ],
      "anthropic-browser": [
        "dist/anthropic-browser.d.ts"
      ]
    }
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD-PARTY.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./workbuddy": {
      "types": "./dist/workbuddy.d.ts",
      "import": "./dist/workbuddy.js"
    },
    "./trae": {
      "types": "./dist/trae.d.ts",
      "import": "./dist/trae.js"
    },
    "./openai": {
      "types": "./dist/openai.d.ts",
      "import": "./dist/openai.js"
    },
    "./anthropic": {
      "types": "./dist/anthropic.d.ts",
      "import": "./dist/anthropic.js"
    },
    "./anthropic-browser": {
      "types": "./dist/anthropic-browser.d.ts",
      "import": "./dist/anthropic-browser.js"
    },
    "./grok": {
      "types": "./dist/grok.d.ts",
      "import": "./dist/grok.js"
    },
    "./ollama": {
      "types": "./dist/ollama.d.ts",
      "import": "./dist/ollama.js"
    },
    "./opencode": {
      "types": "./dist/opencode.d.ts",
      "import": "./dist/opencode.js"
    },
    "./usage": {
      "types": "./dist/usage.d.ts",
      "import": "./dist/usage.js"
    },
    "./reset-credits": {
      "types": "./dist/reset-credits.d.ts",
      "import": "./dist/reset-credits.js"
    },
    "./pi": {
      "types": "./dist/pi.d.ts",
      "import": "./dist/pi.js"
    },
    "./client-versions": {
      "types": "./dist/client-versions.d.ts",
      "import": "./dist/client-versions.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit"
  },
  "dependencies": {
    "@puppeteer/browsers": "3.2.5",
    "tough-cookie": "6.0.2",
    "ws": "^8.22.0"
  },
  "peerDependencies": {
    "@model-auth/core": "^0.11.1"
  },
  "devDependencies": {
    "@model-auth/core": "workspace:*",
    "@types/ws": "8.18.1"
  }
}
